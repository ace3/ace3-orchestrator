POSTGRES_PASSWORD=replace-with-random-production-db-password
MP_API_TOKEN=replace-with-random-production-token-at-least-32-chars
MP_ENV=production
MP_PUBLIC_PORT=8080
MP_HEARTBEAT_INTERVAL=60s
MP_WORKERS=4
MP_MAX_TASKS_PER_HEARTBEAT=10
MP_CLI_TIMEOUT=600s
MP_RUN_MAX_USD=1.00
MP_MONTH_MAX_USD=100.00
MP_RUNNER_MODE=cli
MP_ENABLE_REAL_CLI=true
MP_REPO_ALLOWLIST=/host/code
HOST_CODE_DIR=${HOME}/code
HOST_CLAUDE_DIR=${HOME}/.claude
HOST_CODEX_DIR=${HOME}/.config/codex
